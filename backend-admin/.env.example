NODE_ENV=development
HOST=127.0.0.1
PORT=8121
LOG_LEVEL=info
ADMIN_AUTH_DISABLED=false
ADMIN_API_TOKEN=
PROJECTS_CONFIG_PATH=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

EVENT_DEDUPE_TTL_SECONDS=604800
RANK_TIMEZONE_OFFSET_MINUTES=480

# envPrefix=CARS in config/projects.json. Project-prefixed connection values are optional
# overrides; platform credentials and mock mode are always project-prefixed.
CARS_MYSQL_HOST=
CARS_MYSQL_PORT=
CARS_MYSQL_USER=
CARS_MYSQL_PASSWORD=
CARS_MYSQL_CONNECTION_LIMIT=
CARS_REDIS_HOST=
CARS_REDIS_PORT=
CARS_REDIS_PASSWORD=
CARS_MOCK_MODE=true
CARS_DOUYIN_APP_ID=
CARS_DOUYIN_APP_SECRET=
CARS_KUAISHOU_APP_ID=
CARS_KUAISHOU_APP_SECRET=

# envPrefix=TOWER_DY / TOWER_KS. Pure tower_config projects only use MySQL;
# mock mode remains explicit so local tokenless admin mode can validate every project.
TOWER_DY_MYSQL_HOST=
TOWER_DY_MYSQL_PORT=
TOWER_DY_MYSQL_USER=
TOWER_DY_MYSQL_PASSWORD=
TOWER_DY_MYSQL_CONNECTION_LIMIT=
TOWER_DY_MOCK_MODE=true

TOWER_KS_MYSQL_HOST=
TOWER_KS_MYSQL_PORT=
TOWER_KS_MYSQL_USER=
TOWER_KS_MYSQL_PASSWORD=
TOWER_KS_MYSQL_CONNECTION_LIMIT=
TOWER_KS_MOCK_MODE=true
